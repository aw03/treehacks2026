// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELED
  NO_SHOW
}

model Business {
  id        String   @id @default(uuid())
  name      String
  email     String?  @unique
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // NEW (walk-in window + timezone)
  timezone       String  @default("America/New_York")
  walkInEnabled  Boolean @default(false)
  walkInStartMin Int     @default(600)  // 10:00 AM
  walkInEndMin   Int     @default(1080) // 6:00 PM

  clients          Client[]
  services         Service[]
  appointments     Appointment[]
  supplies         SupplyItem[]
  serviceInstances ServiceInstance[]
}

model Client {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  email     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  appointments Appointment[]
  // Optional uniqueness (only if you want)
  // @@unique([businessId, phone])
  // @@unique([businessId, email])

  @@index([businessId])
}

model Service {
  id          String   @id @default(uuid())
  name        String  
  price       Decimal  @db.Decimal(10, 2)
  durationMin Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  appointments     Appointment[]
  serviceInstances ServiceInstance[]

  @@index([businessId])
}

model Appointment {
  id             String            @id @default(uuid())
  startTime      DateTime
  endTime        DateTime
  status         AppointmentStatus @default(SCHEDULED)
  notes          String?
  // Keeps historical accuracy if service price changes:
  priceAtBooking Decimal?          @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  serviceId       String
  service         Service          @relation(fields: [serviceId], references: [id])
  serviceInstance ServiceInstance?

  @@index([businessId, startTime])
  @@index([clientId])
  @@index([serviceId])
}

model SupplyItem {
  id          String   @id @default(uuid())
  name        String
  unit        String? // e.g., "ml", "oz", "pieces"
  quantity    Decimal  @db.Decimal(10, 2)
  reorderAt   Decimal? @db.Decimal(10, 2)
  costPerUnit Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  businessId                  String
  business                    Business                     @relation(fields: [businessId], references: [id])
  serviceInstanceSupplyUsages ServiceInstanceSupplyUsage[]

  @@index([businessId])
}

enum ServiceInstanceSource {
  APPOINTMENT
  WALK_IN
}

model ServiceInstance {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  finalizedAt DateTime?

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  // If created from an appointment
  appointmentId String?      @unique
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])

  source ServiceInstanceSource @default(APPOINTMENT)

  // Historical fields you want to log
  actualDurationMin Int?
  notes             String?

  // Optional: store derived metrics at time of completion
  // so later edits to service price don’t change history
  priceAtCompletion Decimal? @db.Decimal(10, 2)

  supplyUsages ServiceInstanceSupplyUsage[]
}

model ServiceInstanceSupplyUsage {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  instanceId String
  instance   ServiceInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  supplyId String
  supply   SupplyItem @relation(fields: [supplyId], references: [id])

  quantityUsed Decimal @db.Decimal(10, 2)
  unit         String? // optional snapshot if you want; supply has unit too

  // Optional: store how you got the number
  method   String? // "manual" | "llm" | "cv"
  rawInput String? // text entered or metadata about image inference

  @@index([instanceId])
  @@index([supplyId])
}
